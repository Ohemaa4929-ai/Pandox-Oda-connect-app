# PANDOX ODA CONNECT — environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.

# --- Core ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DB_PATH=./data/pandox.db

# --- Security (REQUIRED — generate strong random values) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-64-hex-chars
ENCRYPTION_KEY=change-me-64-hex-chars

# --- Owner bootstrap (first admin; SUPER_ADMIN) ---
ADMIN_EMAIL=owner@pandoxoda.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=PANDOX Owner

# --- Payment gateway (Paystack — Ghana) ---
# Leave empty to keep payments NOT CONFIGURED (honest state, no fake gateway).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PANDOX ODA CONNECT <no-reply@pandoxoda.com>

# --- SMS ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=

# --- Maps ---
MAPS_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./uploads
